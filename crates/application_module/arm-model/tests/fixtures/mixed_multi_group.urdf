<?xml version="1.0"?>
<robot name="mixed_multi_group">
  <link name="base_link"/>
  <link name="torso"/>
  <link name="left_link"/>
  <link name="left_tip"/>
  <link name="right_link"/>
  <link name="right_tip"/>

  <joint name="torso_fixed" type="fixed">
    <parent link="base_link"/><child link="torso"/>
    <origin xyz="0 0 0.2"/>
  </joint>
  <joint name="left_yaw" type="revolute">
    <parent link="torso"/><child link="left_link"/>
    <origin xyz="0 0.2 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" velocity="2.0" effort="12.0"/>
  </joint>
  <joint name="left_slide" type="prismatic">
    <parent link="left_link"/><child link="left_tip"/>
    <origin xyz="0.2 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.3" velocity="0.5" effort="100.0"/>
  </joint>
  <joint name="right_roll" type="continuous">
    <parent link="torso"/><child link="right_link"/>
    <origin xyz="0 -0.2 0"/><axis xyz="1 0 0"/>
    <limit velocity="3.0" effort="10.0"/>
  </joint>
  <joint name="right_tool_fixed" type="fixed">
    <parent link="right_link"/><child link="right_tip"/>
    <origin xyz="0.25 0 0"/>
  </joint>
</robot>

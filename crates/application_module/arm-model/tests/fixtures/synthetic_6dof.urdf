<?xml version="1.0"?>
<robot name="synthetic_6dof">
  <link name="base_link">
    <inertial><mass value="1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <link name="link_1">
    <inertial><origin xyz="0.1 0 0"/><mass value="1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <link name="link_2">
    <inertial><origin xyz="0.1 0 0"/><mass value="0.9"/><inertia ixx="0.018" ixy="0" ixz="0" iyy="0.018" iyz="0" izz="0.018"/></inertial>
  </link>
  <link name="link_3">
    <inertial><origin xyz="0.08 0 0"/><mass value="0.8"/><inertia ixx="0.016" ixy="0" ixz="0" iyy="0.016" iyz="0" izz="0.016"/></inertial>
  </link>
  <link name="link_4">
    <inertial><origin xyz="0.06 0 0"/><mass value="0.6"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.012"/></inertial>
  </link>
  <link name="link_5">
    <inertial><origin xyz="0.04 0 0"/><mass value="0.4"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial>
  </link>
  <link name="link_6">
    <inertial><origin xyz="0.03 0 0"/><mass value="0.3"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/></inertial>
  </link>
  <link name="tool0">
    <inertial><mass value="0.1"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" velocity="2.0" effort="30.0"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0.25 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="2.0" effort="25.0"/>
  </joint>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0.22 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="2.5" effort="20.0"/>
  </joint>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0.18 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.0" upper="3.0" velocity="3.0" effort="15.0"/>
  </joint>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0.12 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" velocity="3.0" effort="10.0"/>
  </joint>
  <joint name="joint_6" type="continuous">
    <parent link="link_5"/><child link="link_6"/>
    <origin xyz="0.08 0 0"/><axis xyz="1 0 0"/>
    <limit velocity="4.0" effort="8.0"/>
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="link_6"/><child link="tool0"/>
    <origin xyz="0.06 0 0"/>
  </joint>
</robot>

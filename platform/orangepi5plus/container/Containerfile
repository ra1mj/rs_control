ARG BASE_IMAGE=ubuntu:22.04@sha256:0d779ea97881505f5ef0039336ee85edba27519bdba968c284c86ee066a973c8
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bc \
        bison \
        build-essential \
        ca-certificates \
        cpio \
        curl \
        debhelper \
        device-tree-compiler \
        fakeroot \
        flex \
        git \
        kmod \
        libelf-dev \
        libssl-dev \
        lz4 \
        python3 \
        rsync \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENTRYPOINT ["/workspace/platform/orangepi5plus/kernel/build-kernel.sh"]

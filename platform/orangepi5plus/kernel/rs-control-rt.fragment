# rs-control safety and realtime requirements applied after the vendor config.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_PERIODIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPTION=y
CONFIG_CPU_ISOLATION=y
CONFIG_CPUSETS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Thermal protection is deliberately restored after Orange Pi's RT fragment.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_THERMAL=y

# Classic SocketCAN and the RK3588 controller.
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_CAN_DEV=m
CONFIG_CAN_CALC_BITTIMING=y
CONFIG_CAN_ROCKCHIP=m
CONFIG_CANFD_ROCKCHIP=m

# RK3588 UART and common USB IMU adapters.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_XSENS_MT=m

# USB cameras and RK3588 MIPI/V4L2/DMABUF support.
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_V4L2_FWNODE=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMABUF_HEAPS=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_ACM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_VIDEO_ROCKCHIP_CIF=y
CONFIG_VIDEO_ROCKCHIP_ISP=y
CONFIG_VIDEO_ROCKCHIP_ISP_VERSION_V30=y
CONFIG_GENERIC_PHY_MIPI_DPHY=y
CONFIG_PHY_ROCKCHIP_CSI2_DPHY=y
CONFIG_PHY_ROCKCHIP_MIPI_RX=y

# Board Ethernet used by middleware, commands, sensors and qualification load.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y

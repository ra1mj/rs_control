# Checked motor-disabled host profile. Install as /etc/rs-control/navigation.env.
RS_CONTROL_BIN=/opt/rs-control/bin
NAV_MANIFEST=/opt/rs-control/share/rs_control_navigation_plugin.yaml
NAV_MANIFEST_SHA256=798fb5358dc3b9375b1102c92db75cf558491d8db1841785e3c2286bcda4b8ca
NAV_PEER_MANIFEST=/opt/chassis_nav/share/chassis_nav_bringup/config/rs_control_navigation_plugin.yaml
NAV_IPC_ROOT=/run/rs-control-navigation/ipc
NAV_BASE_PARAMS=/opt/chassis_nav/share/chassis_nav_mecanum_navigation/config/mecanum_nav2.yaml
NAV_TUNING_PARAMS=/opt/chassis_nav/share/chassis_nav_mecanum_sim/config/mecanum_nav2_tuning.yaml
NAV_INTEGRATION_PARAMS=/opt/chassis_nav/share/chassis_nav_bringup/config/rs_control_navigation.yaml
NAV_MAP_MANIFEST=/opt/chassis_nav/share/chassis_nav_mecanum_sim/assets/localization_map/warehouse_sim_map/0.1.0/manifest.yaml
NAV_MAP_YAML=/opt/chassis_nav/share/chassis_nav_mecanum_sim/assets/localization_map/warehouse_sim_map/0.1.0/maps/occupancy.yaml
NAV_MAP_IMAGE=/opt/chassis_nav/share/chassis_nav_mecanum_sim/assets/localization_map/warehouse_sim_map/0.1.0/maps/occupancy.pgm
NAV_POSE_BT=/opt/chassis_nav/share/chassis_nav_mecanum_navigation/behavior_trees/navigate_to_pose_fail_closed.xml
NAV_THROUGH_BT=/opt/chassis_nav/share/chassis_nav_mecanum_navigation/behavior_trees/navigate_through_poses_disabled.xml
NAV_NAVIGATE_TO_POSE_INTERFACE=/opt/ros/humble/share/nav2_msgs/action/NavigateToPose.action
NAV_CONTROLLER_PROPOSAL_INTERFACE=/opt/ros/humble/share/geometry_msgs/msg/Twist.msg
NAV_PROPOSAL_TOPIC=/rs_control/navigation/controller_proposal
NAV_ODOMETRY_TOPIC=/rs_control/navigation/odometry
NAV_DYNAMIC_TF_TOPIC=/tf

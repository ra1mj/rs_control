[Unit]
Description=Headless chassis_nav profile for rs_control motor-disabled integration
PartOf=rs-control-navigation.target
Requires=rs-control-navigation-harness.service rs-control-navigation-bridge.service
After=rs-control-navigation-harness.service rs-control-navigation-bridge.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Slice=rs-control-navigation.slice
EnvironmentFile=/etc/rs-control/navigation.env
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec /opt/rs-control/libexec/run-nav2-headless.sh'
ExecStartPost=/bin/bash -c '/opt/rs-control/libexec/wait_nav2_ready.py /navigate_to_pose 60 /lifecycle_manager_navigation && /usr/bin/touch /run/rs-control-navigation/nav2.ready'
ExecStopPost=/usr/bin/rm -f /run/rs-control-navigation/nav2.ready
Restart=on-failure
RestartSec=2
TimeoutStartSec=75
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/rs-control-navigation

[Install]
WantedBy=rs-control-navigation.target
